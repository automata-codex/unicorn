vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Build outputs
dist/
build/

# OS files
.DS_Store

# Local dev certificates (generated per-machine via mkcert)
infra/traefik/certs/

# Playtest-review artifacts (contain prompt text + playtest transcripts)
apps/zoltar-be/playtest-reports/

# Synthesis save files (contain full GM context blob including hidden information)
apps/zoltar-be/synthesis-saves/

# Local database backups (contain full campaign/session data)
infra/db/backups/

# Python ingestion pipeline (ingestion/ sits outside the npm workspace globs)
ingestion/.venv/
__pycache__/
*.pyc
.pytest_cache/
# Index provenance from the last local ingestion run — describes one machine's
# index build, read by task eval:retrieval to stamp its run manifests.
ingestion/.ingest-manifest.json
# Section headings dumped by `ingest.py --dump-headings`, consumed by
# `eval:primer-audit`. A per-machine cache of the book's structure, keyed to
# the source PDF -- same posture as the manifest above, and it is derived from
# a document that does not ship.
ingestion/.headings-*.json

# Fixup replacement text. A template holds whatever a mangled block should
# have contained -- for a broken table, that is the table, which is book text.
# `docs/rules-ingestion.md § What ships in the repository` says extracted text
# does not ship, and the M7.5 spec puts curated book text on the operator's
# disk, not in version control. `fixups.json` itself stays tracked: block ids
# and template filenames, no book text, same posture as the retrieval fixtures.
# `.gitkeep` is kept so the directory survives a clone.
ingestion/*/templates/*
!ingestion/*/templates/.gitkeep

# Personal notes — kept on disk, not tracked
docs/mental-health-toolkit.md
/.claude/worktrees/
